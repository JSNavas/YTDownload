{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTDownload",
  "version": "0.1.0",
  "identifier": "io.github.ytdownload",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YTDownload",
        "width": 900,
        "height": 720,
        "minWidth": 680,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Descarga videos y playlists de YouTube en MP3 o MP4",
    "longDescription": "YTDownload descarga videos y playlists de YouTube en MP3 o MP4. Sin anuncios, sin limites, sin telemetria. Usa yt-dlp y ffmpeg."
  }
}